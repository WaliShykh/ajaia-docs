# Only what's needed to build and run goes to Vercel.
# Patterns are anchored with a leading "/" so they only match at the repo root —
# an unanchored "docs" would also drop app/(app)/docs (the document page route).
/node_modules
/.next
/.data
/.env*
/coverage
*.log
*.tsbuildinfo
/tests
/docs
/AI_WORKFLOW.md
/ARCHITECTURE.md
/SUBMISSION.md
/VIDEO_URL.txt
